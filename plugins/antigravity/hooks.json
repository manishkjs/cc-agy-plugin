{
  "cc-agy-plugin": {
    "SessionStart": [
      {
        "type": "command",
        "command": "@PYTHON@ @PLUGIN_ROOT@/scripts/hook_adapter.py --host agy --event SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "@PYTHON@ @PLUGIN_ROOT@/scripts/hook_adapter.py --host agy --event UserPromptSubmit",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "view_file|read_file|write_file|edit_file|replace_file_content|multi_replace_file_content|write_to_file|grep_search|find_by_name|run_command|call_mcp_tool|mcp_.+_delegate_.+",
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ @PLUGIN_ROOT@/scripts/hook_adapter.py --host agy --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "call_mcp_tool|mcp_(?:agy|vertex|cc-agy-plugin|cc_agy_plugin)_.+|mcp_.+_(?:delegate_start|delegate_continue|delegate_result|delegate_to_gemini|delegate_apply)",
        "hooks": [
          {
            "type": "command",
            "command": "@PYTHON@ @PLUGIN_ROOT@/scripts/hook_adapter.py --host agy --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "@PYTHON@ @PLUGIN_ROOT@/scripts/hook_adapter.py --host agy --event Stop",
        "timeout": 15
      }
    ]
  }
}
