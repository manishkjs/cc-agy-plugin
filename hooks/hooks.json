{
  "description": "Guardrails, receipt ledger logging, and outcome-based diff provenance checks for cc-agy-plugin.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__plugin_cc-agy-plugin_vertex__delegate_.*|mcp__vertex__delegate_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_cc-agy-plugin_vertex__.*|mcp__vertex__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/post_tool_ledger.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/provenance_check.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
