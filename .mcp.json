{
  "mcpServers": {
    "vertex": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/main.py"
      ],
      "env": {
        "CC_AGY_USERCFG_AUTH_MODE": "${user_config.auth_mode}",
        "CC_AGY_USERCFG_AGY_CLI_PATH": "${user_config.agy_cli_path}",
        "CC_AGY_USERCFG_GEMINI_API_KEY": "${user_config.gemini_api_key}",
        "CC_AGY_USERCFG_GOOGLE_CLOUD_PROJECT": "${user_config.google_cloud_project}",
        "CC_AGY_USERCFG_GOOGLE_CLOUD_LOCATION": "${user_config.google_cloud_location}",
        "CC_AGY_USERCFG_COST_PROFILE": "${user_config.cost_profile}",
        "CC_AGY_USERCFG_DEFAULT_DELEGATE_MODEL": "${user_config.default_delegate_model}",
        "CC_AGY_USERCFG_DEFAULT_ASK_MODEL": "${user_config.default_ask_model}",
        "CC_AGY_USERCFG_STRICT_MODE": "${user_config.strict_delegation_mode}",
        "CC_AGY_USERCFG_VERTEX_BASE_URL": "${user_config.vertex_base_url}",
        "CC_AGY_USERCFG_GATEWAY_WIRE": "${user_config.gateway_wire}",
        "CC_AGY_USERCFG_VERTEX_BASE_URL_TOKEN": "${user_config.vertex_base_url_token}",
        "CC_AGY_USERCFG_BIFROST_VIRTUAL_KEY": "${user_config.bifrost_virtual_key}",
        "CC_AGY_USERCFG_VERTEX_BASE_URL_AUDIENCE": "${user_config.vertex_base_url_audience}",
        "CC_AGY_USERCFG_TELEMETRY_SINK": "${user_config.telemetry_sink}",
        "CC_AGY_USERCFG_TELEMETRY_TOKEN": "${user_config.telemetry_token}",
        "CC_AGY_USERCFG_MAX_DAILY_CENTS": "${user_config.max_daily_cents}",
        "CC_AGY_USERCFG_ALLOWED_PROJECTS": "${user_config.allowed_projects}",
        "CC_AGY_USERCFG_BLOCKED_PROJECTS": "${user_config.blocked_projects}",
        "CC_AGY_USERCFG_ENTERPRISE_ADC": "${user_config.enterprise_adc}",
        "CC_AGY_USERCFG_ENTERPRISE_PROJECT": "${user_config.enterprise_project}",
        "CC_AGY_USERCFG_ENTERPRISE_LOCATION": "${user_config.enterprise_location}",
        "CC_AGY_USERCFG_ENTERPRISE_USER_TIER": "${user_config.enterprise_user_tier}",
        "CC_AGY_USERCFG_BIFROST_POLICY_URL": "${user_config.bifrost_policy_url}",
        "CC_AGY_USERCFG_BIFROST_AGY_VIRTUAL_KEY": "${user_config.bifrost_agy_virtual_key}",
        "CC_AGY_USERCFG_BIFROST_POLICY_USER": "${user_config.bifrost_policy_user}",
        "CC_AGY_USERCFG_BIFROST_POLICY_PASSWORD": "${user_config.bifrost_policy_password}",
        "CC_AGY_USERCFG_BIFROST_AGY_POLICY_MODEL": "${user_config.bifrost_agy_policy_model}",
        "CC_AGY_USERCFG_WORKER_SANDBOX": "${user_config.worker_sandbox}",
        "CC_AGY_USERCFG_AUTO_APPLY_ON_PASS": "${user_config.auto_apply_on_pass}"
      },
      "timeout": 1800000
    }
  }
}
